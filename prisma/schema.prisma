generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth models ─────────────────────────────────────────

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  language      String    @default("en")
  planetTexture String    @default("jupiter.jpg")
  planetTint    String    @default("#7c4dbf")
  planetAtmoColor String  @default("#b39ddb")
  planetAtmoDensity Float @default(0.12)
  planetHasRing Boolean   @default(false)
  planetRingColor String  @default("#9b7de0")
  planetRotationSpeed Float @default(0.018)
  planetCloudOpacity Float @default(0.0)
  planetCustomTexture String?
  xp            Int       @default(0)
  userLevel     Int       @default(1)
  lastActiveAt  DateTime? @updatedAt
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  profile  Profile?
  questionnaires QuestionnaireResult[]
  planets  Planet[]
  matchesA Match[] @relation("matchA")
  matchesB Match[] @relation("matchB")
  memberships CommunityMembership[]
  conversationsA ConversationThread[] @relation("convUserA")
  conversationsB ConversationThread[] @relation("convUserB")
  sentMessages   DirectMessage[]
  communityPosts CommunityPost[]
  communityPostReplies CommunityPostReply[]
  communityPostLikes CommunityPostLike[]
  communityDiscussions CommunityDiscussion[]
  communityDiscussionReplies CommunityDiscussionReply[]
  xpEvents XPEvent[]
  notifications Notification[]
  proposedEvents Event[] @relation("ProposedEvents")
  eventRSVPs EventRSVP[]
  createdCommunities Community[] @relation("CommunityCreator")
  posts        Post[]
  postLikes    PostLike[]
  postComments PostComment[]
  postCommentLikes PostCommentLike[]
}

enum NotificationType {
  RESONANCE_RECEIVED
  RESONANCE_ACCEPTED
  GALAXY_NEW_POST
  GALAXY_NEW_EVENT
  EVENT_REMINDER
  LEVEL_UP
  NEW_MATCH
  COMMENT_RECEIVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  xpGranted Int
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Business models ────────────────────────────────────────────

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String   @default("")
  avatarSymbol       String   @default("🪐")
  tagline            String?
  location           String?
  languages          String[] @default([])
  culturalTags       String[] @default([])
  travelCities       String[] @default([])
  musicTaste         String[] @default([])
  bookTaste          String[] @default([])
  filmTaste          String[] @default([])
  communicationStyle String?
  matchPreference    String?  @default("mixed")
  activeStatus       String   @default("active")

  // SBTI
  sbtiType           String?
  sbtiCn             String?
  sbtiPattern        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("profile")
}

model QuestionnaireResult {
  id        String   @id @default(cuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Answers stored as JSON
  answers   Json
  // Derived axes
  mood      String?
  style     String?
  lifestyle String?
  abstractAxis      Float @default(50)
  introspectiveAxis Float @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("questionnaire_result")
}

model Planet {
  id             String   @id @default(cuid())
  userId         String
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String   @default("")
  avatarSymbol   String   @default("🪐")
  tagline        String?
  role           String   @default("explorer")
  mood           String   @default("calm")
  style          String   @default("minimal")
  lifestyle      String   @default("solitary")
  coreThemes     String[] @default([])
  contentFragments String[] @default([])

  // Visual config stored as JSON
  visual         Json     @default("{}")

  // Cognitive axes
  abstractAxis       Float @default(50)
  introspectiveAxis  Float @default(50)

  // Active planet flag
  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchesA       Match[]  @relation("planetMatchA")
  matchesB       Match[]  @relation("planetMatchB")

  @@map("planet")
}

model Match {
  id           String   @id @default(cuid())
  userAId      String
  userBId      String
  planetAId    String
  planetBId    String
  userA        user     @relation("matchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        user     @relation("matchB", fields: [userBId], references: [id], onDelete: Cascade)
  planetA      Planet   @relation("planetMatchA", fields: [planetAId], references: [id], onDelete: Cascade)
  planetB      Planet   @relation("planetMatchB", fields: [planetBId], references: [id], onDelete: Cascade)

  score        Float    @default(0)
  orbitColor   String   @default("blue")
  primaryReason String  @default("shared-interest")
  dimensions   Json     @default("{}")
  similarities String[] @default([])
  differences  String[] @default([])
  resonanceNote String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([planetAId, planetBId])
  @@map("match")
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  symbol      String   @default("🌌")
  tagline     String?
  description String?
  keywords    String[] @default([])
  mood        String   @default("vibrant")
  accentColor String   @default("#6366f1")
  maturity    String   @default("forming")
  creatorId   String?
  creator     user?    @relation("CommunityCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunityMembership[]
  posts       CommunityPost[]
  discussions CommunityDiscussion[]
  events      Event[]

  @@map("community")
}

enum CommunityRole {
  MEMBER
  ADMIN
}

model CommunityMembership {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  role        CommunityRole @default(MEMBER)
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  joinedAt    DateTime  @default(now())

  @@unique([userId, communityId])
  @@map("community_membership")
}

model Event {
  id           String        @id @default(cuid())
  galaxyId     String
  proposerId   String
  title        String
  description  String
  date         DateTime
  location     String?
  onlineUrl    String?
  maxAttendees Int?
  category     EventCategory
  status       EventStatus   @default(PENDING)
  coverImage   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  galaxy       Community     @relation(fields: [galaxyId], references: [id], onDelete: Cascade)
  proposer     user          @relation("ProposedEvents", fields: [proposerId], references: [id], onDelete: Cascade)
  rsvps        EventRSVP[]

  @@index([galaxyId, status, date])
  @@index([proposerId, createdAt])
  @@map("event")
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@map("event_rsvp")
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  PASSED
}

enum EventCategory {
  MEETUP
  ONLINE
  WORKSHOP
  STARGAZING
  DISCUSSION
  OTHER
}

model Post {
  id           String       @id @default(cuid())
  authorId     String
  content      String
  mediaUrls    String[]     @default([])
  mediaTypes   String[]     @default([])
  tags         String[]     @default([])
  category     PostCategory @default(GENERAL)
  likeCount    Int          @default(0)
  commentCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author       user         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  comments     PostComment[]

  @@index([category, createdAt])
  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("post")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_like")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    user     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")
  likes     PostCommentLike[]

  @@index([postId, createdAt])
  @@index([postId, parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
  @@map("post_comment")
}

model PostCommentLike {
  id        String      @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime    @default(now())
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
  @@map("post_comment_like")
}

enum PostCategory {
  GENERAL
  NATURE
  NIGHT
  TRAVEL
  THOUGHTS
  MUSIC
  ART
  COSMIC
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  content     String

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      user      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies     CommunityPostReply[]
  likes       CommunityPostLike[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_post")
}

model CommunityPostReply {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  content   String

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    user          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_post_reply")
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  postId    String
  userId    String

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      user          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("community_post_like")
}

model CommunityDiscussion {
  id          String    @id @default(cuid())
  communityId String
  authorId    String?
  title       String
  heat        Float     @default(0.5)

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      user?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies     CommunityDiscussionReply[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([communityId, title])
  @@index([communityId, updatedAt])
  @@index([authorId, createdAt])
  @@map("community_discussion")
}

model CommunityDiscussionReply {
  id           String              @id @default(cuid())
  discussionId String
  authorId     String?
  authorName   String              @default("Unknown")
  content      String
  seedKey      String?             @unique

  discussion   CommunityDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       user?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([discussionId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_discussion_reply")
}

// --- Messaging ---------------------------------------------------------------

model ConversationThread {
  id             String   @id @default(cuid())
  userAId        String
  userBId        String
  userA          user     @relation("convUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB          user     @relation("convUserB", fields: [userBId], references: [id], onDelete: Cascade)

  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       DirectMessage[]

  @@unique([userAId, userBId])
  @@map("conversation_thread")
}

model DirectMessage {
  id               String   @id @default(cuid())
  conversationId   String
  conversation     ConversationThread @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           user     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content          String
  type             String   @default("text")
  readAt           DateTime?

  createdAt        DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("direct_message")
}
